PORT=7001
REDIS_URL=redis://localhost:6379
MONGODB_URL=mongodb+srv://user:password@cluster.example.mongodb.net/antral

# SMTP for sign-in code emails. Leave SMTP_HOST empty in development to print codes in the console instead.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_PASS = a Google app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Antral <no-reply@example.com>"
